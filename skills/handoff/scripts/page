#!/usr/bin/env bash
# Render a front page (Markdown with the four handoff sections) to HTML and
# open it. The renderer is autopilot's, so a flight's wrap-up and a handoff's
# front page are the same page; the two skills ship from one checkout.
set -euo pipefail
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
renderer=$here/../../autopilot/scripts/autopilot
if [ ! -x "$renderer" ]; then
    echo "page: the autopilot skill's renderer is missing at $renderer" >&2
    exit 1
fi
exec "$renderer" page "$@"
