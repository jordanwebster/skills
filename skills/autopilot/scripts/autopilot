#!/usr/bin/env bash
# Launcher for the autopilot CLI. Resolves the skill directory through any
# symlink so the same file works installed or from a checkout.
set -euo pipefail
script=$0
while [ -L "$script" ]; do
    script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
    target=$(readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$script_dir/$target ;;
    esac
done
here=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)
export PYTHONPATH="$here/../lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m autopilot "$@"
